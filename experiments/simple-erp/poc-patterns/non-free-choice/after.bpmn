<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_role_staff_l3_pr_submit" targetNamespace="https://simple-erp.local/bpm-haqi/role-staff-l3-pr-submit" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:process id="Process_role_staff_l3_pr_submit" name="Submit Purchase Request - Staff" isExecutable="false">
    <bpmn:documentation>Level 3; generator source snapshot; descriptive as-is working tree, not deployed-runtime proof.
Tidak ada pemeriksaan actor==creator untuk submit. Perspektif Staff; definisi operasi bersumber dari L3 P2P bersama.
backend/internal/purchasing/adapter/postgres/store.go :: TransitionRequest</bpmn:documentation>
    <bpmn:laneSet id="Lanes_role_staff_l3_pr_submit">
      <bpmn:lane id="Lane_role_staff_l3_pr_submit_0" name="Staff">
        <bpmn:flowNodeRef>role_staff_l3_pr_submit_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_pr_submit_input</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_role_staff_l3_pr_submit_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>role_staff_l3_pr_submit_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_pr_submit_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_pr_submit_effect0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_pr_submit_effect1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_pr_submit_result_activity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_pr_submit_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LockApprovalRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReturnSubmitReceipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LoadLockedApprovalRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LockedRouteDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OpenStandardReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OpenEscalatedReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RejectUnknownRoute</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="AssignedReviewer" name="Reviewer">
        <bpmn:flowNodeRef>RequestLockedReview</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="role_staff_l3_pr_submit_start" name="Kebutuhan aksi">
      <bpmn:outgoing>role_staff_l3_pr_submit_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="role_staff_l3_pr_submit_input" name="Kirim PR untuk review">
      <bpmn:documentation>Request ini dijalankan oleh Staff; guard backend tetap berlaku.</bpmn:documentation>
      <bpmn:incoming>role_staff_l3_pr_submit_Flow_0</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_pr_submit_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="role_staff_l3_pr_submit_check" name="Lock PR; status DRAFT dan version cocok">
      <bpmn:documentation>Setelah kontrol akses HTTP; lihat l3-kontrol-request. Tidak ada pemeriksaan actor==creator untuk submit.</bpmn:documentation>
      <bpmn:incoming>role_staff_l3_pr_submit_Flow_1</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_pr_submit_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="role_staff_l3_pr_submit_valid" name="Syarat terpenuhi?" gatewayDirection="Diverging">
      <bpmn:incoming>role_staff_l3_pr_submit_Flow_2</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_pr_submit_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>role_staff_l3_pr_submit_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="role_staff_l3_pr_submit_effect0" name="Ubah PR menjadi SUBMITTED; naikkan versi">
      <bpmn:outgoing>role_staff_l3_pr_submit_Flow_4</bpmn:outgoing>
      <bpmn:incoming>RouteLocked</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="role_staff_l3_pr_submit_effect1" name="Audit PUR-PR-002; commit">
      <bpmn:incoming>role_staff_l3_pr_submit_Flow_4</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_pr_submit_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="role_staff_l3_pr_submit_done" name="Respons dikirim">
      <bpmn:incoming>role_staff_l3_pr_submit_result_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="role_staff_l3_pr_submit_Flow_0" sourceRef="role_staff_l3_pr_submit_start" targetRef="role_staff_l3_pr_submit_input" />
    <bpmn:sequenceFlow id="role_staff_l3_pr_submit_Flow_1" sourceRef="role_staff_l3_pr_submit_input" targetRef="role_staff_l3_pr_submit_check" />
    <bpmn:sequenceFlow id="role_staff_l3_pr_submit_Flow_2" sourceRef="role_staff_l3_pr_submit_check" targetRef="role_staff_l3_pr_submit_valid" />
    <bpmn:sequenceFlow id="role_staff_l3_pr_submit_Flow_3" sourceRef="role_staff_l3_pr_submit_valid" targetRef="LockApprovalRoute" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="role_staff_l3_pr_submit_Flow_4" sourceRef="role_staff_l3_pr_submit_effect0" targetRef="role_staff_l3_pr_submit_effect1" />
    <bpmn:sequenceFlow id="role_staff_l3_pr_submit_Flow_5" sourceRef="role_staff_l3_pr_submit_effect1" targetRef="ReturnSubmitReceipt" />
    <bpmn:sequenceFlow id="role_staff_l3_pr_submit_Flow_6" sourceRef="role_staff_l3_pr_submit_valid" targetRef="role_staff_l3_pr_submit_result_activity" name="Tidak; Ditolak / gagal; tidak commit">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Tidak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sendTask id="role_staff_l3_pr_submit_result_activity" name="Kirim respons hasil aksi (sukses atau gagal)">
      <bpmn:documentation>Explicit presentation of existing response handling. Preserve success/error status and payload; no extra commit or state change.</bpmn:documentation>
      <bpmn:incoming>role_staff_l3_pr_submit_Flow_6</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_pr_submit_result_to_end</bpmn:outgoing>
      <bpmn:incoming>OpenStandardReviewDone</bpmn:incoming>
      <bpmn:incoming>OpenEscalatedReviewDone</bpmn:incoming>
      <bpmn:incoming>RejectUnknownRouteDone</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="role_staff_l3_pr_submit_result_to_end" sourceRef="role_staff_l3_pr_submit_result_activity" targetRef="role_staff_l3_pr_submit_done" />
    <bpmn:serviceTask id="LockApprovalRoute" name="Tentukan dan simpan jalur approval PR">
      <bpmn:documentation>Saat submit, total PR di bawah ambang konfigurasi mendapat STANDARD; total yang mencapai ambang mendapat ESCALATED. Simpan rute untuk ID PR yang sama bersama status SUBMITTED dalam satu transaksi. Perubahan ambang berikutnya hanya berlaku pada submit baru.</bpmn:documentation>
      <bpmn:incoming>role_staff_l3_pr_submit_Flow_3</bpmn:incoming>
      <bpmn:outgoing>RouteLocked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="ReturnSubmitReceipt" name="Kirim konfirmasi submit ke Staff">
      <bpmn:incoming>role_staff_l3_pr_submit_Flow_5</bpmn:incoming>
      <bpmn:outgoing>ContinueToReview</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="RequestLockedReview" name="Kirim keputusan approve atau reject">
      <bpmn:documentation>Ini request review PR yang sudah ada dan dapat datang setelah transaksi submit selesai.</bpmn:documentation>
      <bpmn:incoming>ContinueToReview</bpmn:incoming>
      <bpmn:outgoing>ReadLockedRoute</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="LoadLockedApprovalRoute" name="Baca rute yang tersimpan untuk PR ini">
      <bpmn:documentation>Pada request approve maupun reject, baca rute PR yang sama sebelum mutasi. Perubahan ambang tidak mengubah rute PR yang sudah SUBMITTED. Pertahankan pemeriksaan status, versi, kewenangan, dan maker-checker.</bpmn:documentation>
      <bpmn:incoming>ReadLockedRoute</bpmn:incoming>
      <bpmn:outgoing>RouteLoaded</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="LockedRouteDecision" name="Rute review yang tersimpan?" gatewayDirection="Diverging">
      <bpmn:incoming>RouteLoaded</bpmn:incoming>
      <bpmn:outgoing>StoredStandard</bpmn:outgoing>
      <bpmn:outgoing>StoredEscalated</bpmn:outgoing>
      <bpmn:outgoing>MissingRoute</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="OpenStandardReview" name="Validasi Supervisor dan lanjutkan review">
      <bpmn:documentation>STANDARD memberi hak review kepada Supervisor. Tolak role yang tidak cocok sebelum mutasi. Untuk role yang cocok, lanjutkan aksi approve atau reject yang sudah ada.</bpmn:documentation>
      <bpmn:outgoing>OpenStandardReviewDone</bpmn:outgoing>
      <bpmn:incoming>StoredStandard</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="OpenStandardReviewDone" sourceRef="OpenStandardReview" targetRef="role_staff_l3_pr_submit_result_activity" />
    <bpmn:serviceTask id="OpenEscalatedReview" name="Validasi Super Admin dan lanjutkan review">
      <bpmn:documentation>ESCALATED memberi hak review kepada Super Admin. Tolak role yang tidak cocok sebelum mutasi. Untuk role yang cocok, lanjutkan aksi approve atau reject yang sudah ada.</bpmn:documentation>
      <bpmn:outgoing>OpenEscalatedReviewDone</bpmn:outgoing>
      <bpmn:incoming>StoredEscalated</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="OpenEscalatedReviewDone" sourceRef="OpenEscalatedReview" targetRef="role_staff_l3_pr_submit_result_activity" />
    <bpmn:serviceTask id="RejectUnknownRoute" name="Tolak review tanpa mutasi">
      <bpmn:documentation>PR yang tidak punya rute valid gagal secara eksplisit tanpa mengubah status atau versi.</bpmn:documentation>
      <bpmn:outgoing>RejectUnknownRouteDone</bpmn:outgoing>
      <bpmn:incoming>MissingRoute</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="RejectUnknownRouteDone" sourceRef="RejectUnknownRoute" targetRef="role_staff_l3_pr_submit_result_activity" />
    <bpmn:sequenceFlow id="RouteLocked" sourceRef="LockApprovalRoute" targetRef="role_staff_l3_pr_submit_effect0" />
    <bpmn:sequenceFlow id="ContinueToReview" sourceRef="ReturnSubmitReceipt" targetRef="RequestLockedReview" name="Request review berikutnya" />
    <bpmn:sequenceFlow id="ReadLockedRoute" sourceRef="RequestLockedReview" targetRef="LoadLockedApprovalRoute" />
    <bpmn:sequenceFlow id="RouteLoaded" sourceRef="LoadLockedApprovalRoute" targetRef="LockedRouteDecision" />
    <bpmn:sequenceFlow id="StoredStandard" sourceRef="LockedRouteDecision" targetRef="OpenStandardReview" name="jalur tersimpan = STANDARD">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">jalur tersimpan = STANDARD</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="StoredEscalated" sourceRef="LockedRouteDecision" targetRef="OpenEscalatedReview" name="jalur tersimpan = ESCALATED">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">jalur tersimpan = ESCALATED</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="MissingRoute" sourceRef="LockedRouteDecision" targetRef="RejectUnknownRoute" name="Rute kosong atau tidak valid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">rute kosong atau di luar STANDARD dan ESCALATED</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
