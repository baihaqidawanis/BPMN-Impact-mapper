<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:ns3="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:ns4="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_role_staff_l3_adj_submit" targetNamespace="https://simple-erp.local/bpm-haqi/role-staff-l3-adj-submit" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:process id="Process_role_staff_l3_adj_submit" name="Submit stock adjustment - Staff" isExecutable="false">
    <bpmn:documentation>Level 3. Staff mengirim penyesuaian stok untuk ditinjau. Sistem memeriksa status dan versi sebelum memproses permintaan.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_role_staff_l3_adj_submit">
      <bpmn:lane id="Lane_role_staff_l3_adj_submit_0" name="Staff">
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_input</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_role_staff_l3_adj_submit_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_effect0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_effect1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_result_activity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_result_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_Flow_6_prepare_result</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="role_staff_l3_adj_submit_start" name="Kebutuhan aksi">
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="role_staff_l3_adj_submit_input" name="Kirim adjustment untuk review">
      <bpmn:documentation>Aktor alternatif pada lane, bukan dua persetujuan.</bpmn:documentation>
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_0</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="role_staff_l3_adj_submit_check" name="Lock adjustment DRAFT; versi cocok">
      <bpmn:documentation>Setelah kontrol akses HTTP; lihat l3-kontrol-request. </bpmn:documentation>
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_1</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="role_staff_l3_adj_submit_valid" name="Syarat terpenuhi?" gatewayDirection="Diverging">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_2</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="role_staff_l3_adj_submit_effect0" name="Ubah adjustment SUBMITTED">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_3</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="role_staff_l3_adj_submit_effect1" name="Audit INV-ADJ-002; commit">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_4</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_0" sourceRef="role_staff_l3_adj_submit_start" targetRef="role_staff_l3_adj_submit_input" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_1" sourceRef="role_staff_l3_adj_submit_input" targetRef="role_staff_l3_adj_submit_check" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_2" sourceRef="role_staff_l3_adj_submit_check" targetRef="role_staff_l3_adj_submit_valid" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_3" name="Ya" sourceRef="role_staff_l3_adj_submit_valid" targetRef="role_staff_l3_adj_submit_effect0">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_4" sourceRef="role_staff_l3_adj_submit_effect0" targetRef="role_staff_l3_adj_submit_effect1" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_5" sourceRef="role_staff_l3_adj_submit_effect1" targetRef="role_staff_l3_adj_submit_result_merge" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_6" name="Tidak" sourceRef="role_staff_l3_adj_submit_valid" targetRef="role_staff_l3_adj_submit_Flow_6_prepare_result">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Tidak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="role_staff_l3_adj_submit_done" name="Respons dikirim">
      <bpmn:incoming>role_staff_l3_adj_submit_result_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="role_staff_l3_adj_submit_result_activity" name="Kirim respons hasil aksi (sukses atau gagal)">
      <bpmn:documentation>Explicit presentation of existing response handling. Preserve success/error status and payload; no extra commit or state change.</bpmn:documentation>
      <bpmn:incoming>role_staff_l3_adj_submit_result_joined</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_result_to_end</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_result_to_end" sourceRef="role_staff_l3_adj_submit_result_activity" targetRef="role_staff_l3_adj_submit_done" />
    <bpmn:exclusiveGateway id="role_staff_l3_adj_submit_result_merge" gatewayDirection="Converging">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_5</bpmn:incoming>
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_6_prepared</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_result_joined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="role_staff_l3_adj_submit_Flow_6_prepare_result" name="Siapkan respons konflik (409)">
      <bpmn:documentation>Jika versi tidak cocok atau status bukan DRAFT, siapkan respons konflik 409. Status penyesuaian stok tetap sama.</bpmn:documentation>
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_6</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_6_prepared</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_6_prepared" sourceRef="role_staff_l3_adj_submit_Flow_6_prepare_result" targetRef="role_staff_l3_adj_submit_result_merge" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_result_joined" sourceRef="role_staff_l3_adj_submit_result_merge" targetRef="role_staff_l3_adj_submit_result_activity" />
  </bpmn:process>
  <bpmn:collaboration id="Collab_role_staff_l3_adj_submit">
    <bpmn:participant id="Pool_role_staff_l3_adj_submit" name="Simple ERP" processRef="Process_role_staff_l3_adj_submit" />
  </bpmn:collaboration>
