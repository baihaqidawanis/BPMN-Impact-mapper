<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_role_staff_l3_adj_submit" targetNamespace="https://simple-erp.local/bpm-haqi/role-staff-l3-adj-submit" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:process id="Process_role_staff_l3_adj_submit" name="Submit stock adjustment - Staff" isExecutable="false">
    <bpmn:documentation>Level 3; generator source snapshot; descriptive as-is working tree, not deployed-runtime proof.
 Pelaksana request: Staff; guard backend tetap berlaku.
backend/internal/inventory/adapter/postgres/store.go :: TransitionAdjustment</bpmn:documentation>
    <bpmn:laneSet id="Lanes_role_staff_l3_adj_submit">
      <bpmn:lane id="Lane_role_staff_l3_adj_submit_0" name="Staff">
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_input</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_role_staff_l3_adj_submit_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_effect0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_effect1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_result_activity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckZeroDelta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ZeroDeltaDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CloseWithoutAdjustment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SkipOutcomeJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InvalidAdjustment</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="role_staff_l3_adj_submit_start" name="Kebutuhan aksi">
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="role_staff_l3_adj_submit_input" name="Kirim adjustment untuk review">
      <bpmn:documentation>Aktor alternatif pada lane, bukan dua persetujuan.</bpmn:documentation>
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_0</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="role_staff_l3_adj_submit_check" name="Lock adjustment DRAFT; versi cocok">
      <bpmn:documentation>Setelah kontrol akses HTTP; lihat l3-kontrol-request. </bpmn:documentation>
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_1</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="role_staff_l3_adj_submit_valid" name="Syarat terpenuhi?" gatewayDirection="Diverging">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_2</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="role_staff_l3_adj_submit_effect0" name="Ubah adjustment SUBMITTED">
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_4</bpmn:outgoing>
      <bpmn:incoming>SubmitForApproval</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="role_staff_l3_adj_submit_effect1" name="Audit INV-ADJ-002; commit">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_4</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_0" sourceRef="role_staff_l3_adj_submit_start" targetRef="role_staff_l3_adj_submit_input" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_1" sourceRef="role_staff_l3_adj_submit_input" targetRef="role_staff_l3_adj_submit_check" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_2" sourceRef="role_staff_l3_adj_submit_check" targetRef="role_staff_l3_adj_submit_valid" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_3" name="Ya" sourceRef="role_staff_l3_adj_submit_valid" targetRef="CheckZeroDelta">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_4" sourceRef="role_staff_l3_adj_submit_effect0" targetRef="role_staff_l3_adj_submit_effect1" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_5" sourceRef="role_staff_l3_adj_submit_effect1" targetRef="SkipOutcomeJoin" name="Aksi selesai; hasil diterima" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_6" name="Tidak; Ditolak / gagal; tidak commit" sourceRef="role_staff_l3_adj_submit_valid" targetRef="InvalidAdjustment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Tidak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="role_staff_l3_adj_submit_done" name="Respons dikirim">
      <bpmn:incoming>role_staff_l3_adj_submit_result_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="role_staff_l3_adj_submit_result_activity" name="Kirim respons hasil aksi (sukses atau gagal)">
      <bpmn:documentation>Explicit presentation of existing response handling. Preserve success/error status and payload; no extra commit or state change.</bpmn:documentation>
      <bpmn:outgoing>role_staff_l3_adj_submit_result_to_end</bpmn:outgoing>
      <bpmn:incoming>ReturnSkipOutcome</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_result_to_end" sourceRef="role_staff_l3_adj_submit_result_activity" targetRef="role_staff_l3_adj_submit_done" />
    <bpmn:serviceTask id="CheckZeroDelta" name="Periksa apakah semua selisih stok nol">
      <bpmn:documentation>Saat submit, setelah validasi DRAFT dan versi, bandingkan jumlah terhitung dengan snapshot per baris. Satu baris berbeda cukup untuk mengikuti alur SUBMITTED biasa, meski jumlah seluruh selisih nol.</bpmn:documentation>
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_3</bpmn:incoming>
      <bpmn:outgoing>DeltaChecked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ZeroDeltaDecision" name="Semua selisih nol?" gatewayDirection="Diverging">
      <bpmn:incoming>DeltaChecked</bpmn:incoming>
      <bpmn:outgoing>BypassApproval</bpmn:outgoing>
      <bpmn:outgoing>SubmitForApproval</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CloseWithoutAdjustment" name="Tutup sebagai NO_ADJUSTMENT tanpa posting stok">
      <bpmn:documentation>Jika semua baris berselisih nol, simpan NO_ADJUSTMENT, naikkan versi, dan audit dalam transaksi submit sebelum commit dan respons sukses. Lewati antrean approval; posting stok tetap aksi terpisah. Submit dengan versi usang gagal tanpa perubahan.</bpmn:documentation>
      <bpmn:incoming>BypassApproval</bpmn:incoming>
      <bpmn:outgoing>BypassCompleted</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="SkipOutcomeJoin" name="Gabungkan hasil submit" gatewayDirection="Converging">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_5</bpmn:incoming>
      <bpmn:incoming>BypassCompleted</bpmn:incoming>
      <bpmn:incoming>InvalidAdjustmentReady</bpmn:incoming>
      <bpmn:outgoing>ReturnSkipOutcome</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="InvalidAdjustment" name="Siapkan kegagalan validasi submit">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_6</bpmn:incoming>
      <bpmn:outgoing>InvalidAdjustmentReady</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="DeltaChecked" sourceRef="CheckZeroDelta" targetRef="ZeroDeltaDecision" />
    <bpmn:sequenceFlow id="BypassApproval" sourceRef="ZeroDeltaDecision" targetRef="CloseWithoutAdjustment" name="semua selisih nol">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">semua selisih nol</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SubmitForApproval" sourceRef="ZeroDeltaDecision" targetRef="role_staff_l3_adj_submit_effect0" name="ada baris dengan selisih nonnol">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">ada baris dengan selisih nonnol</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BypassCompleted" sourceRef="CloseWithoutAdjustment" targetRef="SkipOutcomeJoin" />
    <bpmn:sequenceFlow id="InvalidAdjustmentReady" sourceRef="InvalidAdjustment" targetRef="SkipOutcomeJoin" />
    <bpmn:sequenceFlow id="ReturnSkipOutcome" sourceRef="SkipOutcomeJoin" targetRef="role_staff_l3_adj_submit_result_activity" />
  </bpmn:process>
