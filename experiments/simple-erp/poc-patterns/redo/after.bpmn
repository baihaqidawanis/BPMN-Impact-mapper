        <di:waypoint x="1562.5" y="528" />
        <di:waypoint x="1562.5" y="422.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="role_supervisor_l3_pr_review_result_to_end_di" bpmnElement="role_supervisor_l3_pr_review_result_to_end">
        <di:waypoint x="2290" y="395.0" />
