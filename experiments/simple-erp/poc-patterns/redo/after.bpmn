<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_role_supervisor_l3_pr_review" targetNamespace="https://simple-erp.local/bpm-haqi/role-supervisor-l3-pr-review" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:process id="Process_role_supervisor_l3_pr_review" name="Review Purchase Request - Supervisor" isExecutable="false">
    <bpmn:documentation>Level 3; generator source snapshot; descriptive as-is working tree, not deployed-runtime proof.
Bypass self-review Super Admin memeriksa role aktif di database; guard status/versi tetap berlaku. Perspektif Supervisor; definisi operasi bersumber dari L3 P2P bersama.
backend/internal/purchasing/adapter/postgres/store.go :: TransitionRequest</bpmn:documentation>
    <bpmn:laneSet id="Lanes_role_supervisor_l3_pr_review">
      <bpmn:lane id="Lane_role_supervisor_l3_pr_review_0" name="Supervisor">
        <bpmn:flowNodeRef>role_supervisor_l3_pr_review_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_supervisor_l3_pr_review_input</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_role_supervisor_l3_pr_review_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>role_supervisor_l3_pr_review_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_supervisor_l3_pr_review_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_supervisor_l3_pr_review_positive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_supervisor_l3_pr_review_negative</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_supervisor_l3_pr_review_effect1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_supervisor_l3_pr_review_result_activity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_supervisor_l3_pr_review_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LoadFirstReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReviewEntryJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReturnPRForRevision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ResubmitRevisedPR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DecisionAuditJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReviewOutcomeJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RedoValidationFailure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="RevisionStaff" name="Staff">
        <bpmn:flowNodeRef>EditReturnedPR</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="role_supervisor_l3_pr_review_start" name="Kebutuhan aksi">
      <bpmn:outgoing>role_supervisor_l3_pr_review_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="role_supervisor_l3_pr_review_input" name="Pilih approve, reject, atau request revision">
      <bpmn:documentation>Request ini dijalankan oleh Supervisor; guard backend tetap berlaku. Panel PR tidak menyediakan input alasan reject; API tetap menerima reason.</bpmn:documentation>
      <bpmn:outgoing>role_supervisor_l3_pr_review_Flow_1</bpmn:outgoing>
      <bpmn:incoming>EnterReview</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:serviceTask id="role_supervisor_l3_pr_review_check" name="Lock PR; SUBMITTED; versi cocok; Supervisor bukan creator; Super Admin boleh self-review">
      <bpmn:documentation>Setelah kontrol akses HTTP; lihat l3-kontrol-request. Bypass self-review Super Admin memeriksa role aktif di database; guard status/versi tetap berlaku.</bpmn:documentation>
      <bpmn:incoming>role_supervisor_l3_pr_review_Flow_1</bpmn:incoming>
      <bpmn:outgoing>role_supervisor_l3_pr_review_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="role_supervisor_l3_pr_review_valid" name="Hasil review PR?" gatewayDirection="Diverging">
      <bpmn:incoming>role_supervisor_l3_pr_review_Flow_2</bpmn:incoming>
      <bpmn:outgoing>role_supervisor_l3_pr_review_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>role_supervisor_l3_pr_review_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>role_supervisor_l3_pr_review_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>RevisionRequested</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="role_supervisor_l3_pr_review_positive" name="Set PR APPROVED">
      <bpmn:incoming>role_supervisor_l3_pr_review_Flow_5</bpmn:incoming>
      <bpmn:outgoing>role_supervisor_l3_pr_review_Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="role_supervisor_l3_pr_review_negative" name="Set PR REJECTED dan alasan">
      <bpmn:incoming>role_supervisor_l3_pr_review_Flow_6</bpmn:incoming>
      <bpmn:outgoing>role_supervisor_l3_pr_review_Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="role_supervisor_l3_pr_review_effect1" name="Simpan reviewer; audit PUR-PR-003; commit">
      <bpmn:outgoing>role_supervisor_l3_pr_review_Flow_3</bpmn:outgoing>
      <bpmn:incoming>DecisionReadyForAudit</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="role_supervisor_l3_pr_review_done" name="Respons dikirim">
      <bpmn:incoming>role_supervisor_l3_pr_review_result_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="role_supervisor_l3_pr_review_Flow_0" sourceRef="role_supervisor_l3_pr_review_start" targetRef="LoadFirstReview" />
    <bpmn:sequenceFlow id="role_supervisor_l3_pr_review_Flow_1" sourceRef="role_supervisor_l3_pr_review_input" targetRef="role_supervisor_l3_pr_review_check" />
    <bpmn:sequenceFlow id="role_supervisor_l3_pr_review_Flow_2" sourceRef="role_supervisor_l3_pr_review_check" targetRef="role_supervisor_l3_pr_review_valid" />
    <bpmn:sequenceFlow id="role_supervisor_l3_pr_review_Flow_3" sourceRef="role_supervisor_l3_pr_review_effect1" targetRef="ReviewOutcomeJoin" name="Aksi selesai; hasil diterima" />
    <bpmn:sequenceFlow id="role_supervisor_l3_pr_review_Flow_4" sourceRef="role_supervisor_l3_pr_review_valid" targetRef="RedoValidationFailure" name="Tidak; Ditolak / gagal; tidak commit">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Tidak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="role_supervisor_l3_pr_review_Flow_5" sourceRef="role_supervisor_l3_pr_review_valid" targetRef="role_supervisor_l3_pr_review_positive" name="Approve">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Approve</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="role_supervisor_l3_pr_review_Flow_6" sourceRef="role_supervisor_l3_pr_review_valid" targetRef="role_supervisor_l3_pr_review_negative" name="Reject">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Reject</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="role_supervisor_l3_pr_review_Flow_7" sourceRef="role_supervisor_l3_pr_review_positive" targetRef="DecisionAuditJoin" />
    <bpmn:sequenceFlow id="role_supervisor_l3_pr_review_Flow_8" sourceRef="role_supervisor_l3_pr_review_negative" targetRef="DecisionAuditJoin" />
    <bpmn:sendTask id="role_supervisor_l3_pr_review_result_activity" name="Kirim respons hasil aksi (sukses atau gagal)">
      <bpmn:documentation>Explicit presentation of existing response handling. Preserve success/error status and payload; no extra commit or state change.</bpmn:documentation>
      <bpmn:outgoing>role_supervisor_l3_pr_review_result_to_end</bpmn:outgoing>
      <bpmn:incoming>ReturnReviewOutcome</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="role_supervisor_l3_pr_review_result_to_end" sourceRef="role_supervisor_l3_pr_review_result_activity" targetRef="role_supervisor_l3_pr_review_done" />
    <bpmn:serviceTask id="LoadFirstReview" name="Muat PR yang menunggu review">
      <bpmn:incoming>role_supervisor_l3_pr_review_Flow_0</bpmn:incoming>
      <bpmn:outgoing>FirstReviewReady</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ReviewEntryJoin" name="Masuk ke review PR" gatewayDirection="Converging">
      <bpmn:incoming>FirstReviewReady</bpmn:incoming>
      <bpmn:outgoing>EnterReview</bpmn:outgoing>
      <bpmn:incoming>BackToReview</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ReturnPRForRevision" name="Simpan catatan dan status REVISION_REQUIRED">
      <bpmn:documentation>Reviewer yang berhak meminta revisi pada PR SUBMITTED dengan versi cocok dan catatan terisi. Simpan status, catatan, audit, dan versi baru dalam satu transaksi. Kirim respons setelah commit sebelum menunggu perbaikan dari Staff.</bpmn:documentation>
      <bpmn:incoming>RevisionRequested</bpmn:incoming>
      <bpmn:outgoing>ReturnedToStaff</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="EditReturnedPR" name="Perbaiki PR yang sama dan ajukan ulang">
      <bpmn:incoming>ReturnedToStaff</bpmn:incoming>
      <bpmn:outgoing>ApplyRevision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ResubmitRevisedPR" name="Validasi revisi dan simpan PR sebagai SUBMITTED">
      <bpmn:documentation>Pada request terpisah, pembuat mengirim ulang PR REVISION_REQUIRED dengan versi cocok. Simpan revisi dan versi baru pada ID yang sama, audit, commit, lalu kembalikan PR ke antrean review. Versi usang atau pengirim yang berbeda gagal tanpa perubahan. REJECTED tetap terminal.</bpmn:documentation>
      <bpmn:incoming>ApplyRevision</bpmn:incoming>
      <bpmn:outgoing>BackToReview</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="FirstReviewReady" sourceRef="LoadFirstReview" targetRef="ReviewEntryJoin" />
    <bpmn:sequenceFlow id="EnterReview" sourceRef="ReviewEntryJoin" targetRef="role_supervisor_l3_pr_review_input" />
    <bpmn:sequenceFlow id="RevisionRequested" sourceRef="role_supervisor_l3_pr_review_valid" targetRef="ReturnPRForRevision" name="Minta revisi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">action = request_revision dan catatan tidak kosong</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ReturnedToStaff" sourceRef="ReturnPRForRevision" targetRef="EditReturnedPR" />
    <bpmn:sequenceFlow id="ApplyRevision" sourceRef="EditReturnedPR" targetRef="ResubmitRevisedPR" />
    <bpmn:exclusiveGateway id="DecisionAuditJoin" name="Gabung hasil keputusan" gatewayDirection="Converging">
      <bpmn:incoming>role_supervisor_l3_pr_review_Flow_7</bpmn:incoming>
      <bpmn:incoming>role_supervisor_l3_pr_review_Flow_8</bpmn:incoming>
      <bpmn:outgoing>DecisionReadyForAudit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="DecisionReadyForAudit" sourceRef="DecisionAuditJoin" targetRef="role_supervisor_l3_pr_review_effect1" />
    <bpmn:exclusiveGateway id="ReviewOutcomeJoin" name="Gabung hasil review" gatewayDirection="Converging">
      <bpmn:incoming>role_supervisor_l3_pr_review_Flow_3</bpmn:incoming>
      <bpmn:incoming>ReviewValidationFailureReady</bpmn:incoming>
      <bpmn:outgoing>ReturnReviewOutcome</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="RedoValidationFailure" name="Siapkan respons gagal validasi review">
      <bpmn:incoming>role_supervisor_l3_pr_review_Flow_4</bpmn:incoming>
      <bpmn:outgoing>ReviewValidationFailureReady</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="ReviewValidationFailureReady" sourceRef="RedoValidationFailure" targetRef="ReviewOutcomeJoin" />
    <bpmn:sequenceFlow id="ReturnReviewOutcome" sourceRef="ReviewOutcomeJoin" targetRef="role_supervisor_l3_pr_review_result_activity" />
    <bpmn:sequenceFlow id="BackToReview" sourceRef="ResubmitRevisedPR" targetRef="ReviewEntryJoin" name="Kembali ke antrean review" />
  </bpmn:process>
  <bpmn:collaboration id="Collab_role_supervisor_l3_pr_review">
    <bpmn:participant id="Pool_role_supervisor_l3_pr_review" name="Simple ERP" processRef="Process_role_supervisor_l3_pr_review" />
  </bpmn:collaboration>
