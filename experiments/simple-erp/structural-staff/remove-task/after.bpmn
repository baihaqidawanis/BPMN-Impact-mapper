<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_role_staff_l3_adj_cancel" targetNamespace="https://simple-erp.local/bpm-haqi/role-staff-l3-adj-cancel" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:process id="Process_role_staff_l3_adj_cancel" name="Batalkan adjustment draft atau approved - Staff" isExecutable="false">
    <bpmn:documentation>Level 3; generator source snapshot; descriptive as-is working tree, not deployed-runtime proof.
Jika stok berubah setelah APPROVED, Staff membatalkan dengan alasan, membuat draft baru dari snapshot terkini, lalu meminta approval ulang. Pelaksana request: Staff; guard backend tetap berlaku.
backend/internal/inventory/adapter/postgres/store.go :: TransitionAdjustment</bpmn:documentation>
    <bpmn:laneSet id="Lanes_role_staff_l3_adj_cancel">
      <bpmn:lane id="Lane_role_staff_l3_adj_cancel_0" name="Staff">
        <bpmn:flowNodeRef>role_staff_l3_adj_cancel_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_role_staff_l3_adj_cancel_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>role_staff_l3_adj_cancel_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_cancel_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_cancel_effect0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_cancel_effect1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_cancel_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_cancel_failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="role_staff_l3_adj_cancel_start" name="Kebutuhan aksi">
      <bpmn:outgoing>role_staff_l3_adj_cancel_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="role_staff_l3_adj_cancel_check" name="DRAFT or APPROVED; matching version; creator or active Super Admin">
      <bpmn:documentation>Setelah kontrol akses HTTP; lihat l3-kontrol-request. Jika stok berubah setelah APPROVED, Staff membatalkan dengan alasan, membuat draft baru dari snapshot terkini, lalu meminta approval ulang.</bpmn:documentation>
      <bpmn:incoming>role_staff_l3_adj_cancel_Flow_0</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_cancel_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="role_staff_l3_adj_cancel_valid" name="Syarat terpenuhi?" gatewayDirection="Diverging">
      <bpmn:incoming>role_staff_l3_adj_cancel_Flow_2</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_cancel_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>role_staff_l3_adj_cancel_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="role_staff_l3_adj_cancel_effect0" name="Ubah adjustment CANCELLED">
      <bpmn:incoming>role_staff_l3_adj_cancel_Flow_3</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_cancel_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="role_staff_l3_adj_cancel_effect1" name="Audit ACT-INV-ADJ-CANCEL; commit">
      <bpmn:incoming>role_staff_l3_adj_cancel_Flow_4</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_cancel_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="role_staff_l3_adj_cancel_Flow_0" sourceRef="role_staff_l3_adj_cancel_start" targetRef="role_staff_l3_adj_cancel_check" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_cancel_Flow_2" sourceRef="role_staff_l3_adj_cancel_check" targetRef="role_staff_l3_adj_cancel_valid" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_cancel_Flow_3" name="Ya" sourceRef="role_staff_l3_adj_cancel_valid" targetRef="role_staff_l3_adj_cancel_effect0">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="role_staff_l3_adj_cancel_Flow_4" sourceRef="role_staff_l3_adj_cancel_effect0" targetRef="role_staff_l3_adj_cancel_effect1" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_cancel_Flow_5" sourceRef="role_staff_l3_adj_cancel_effect1" targetRef="role_staff_l3_adj_cancel_done" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_cancel_Flow_6" name="Tidak" sourceRef="role_staff_l3_adj_cancel_valid" targetRef="role_staff_l3_adj_cancel_failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Tidak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="role_staff_l3_adj_cancel_done" name="Aksi selesai; hasil diterima">
      <bpmn:incoming>role_staff_l3_adj_cancel_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="role_staff_l3_adj_cancel_failed" name="Ditolak / gagal; tidak commit">
      <bpmn:incoming>role_staff_l3_adj_cancel_Flow_6</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
