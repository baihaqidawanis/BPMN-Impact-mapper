  <bpmn:process id="Process_role_staff_l3_pr_create" name="Buat Purchase Request - Staff" isExecutable="false">
    <bpmn:documentation>Level 3; generator source snapshot; descriptive as-is working tree, not deployed-runtime proof.
 Perspektif Staff; definisi operasi bersumber dari L3 P2P bersama.
backend/internal/purchasing/adapter/postgres/store.go :: CreateRequest</bpmn:documentation>
    <bpmn:laneSet id="Lanes_role_staff_l3_pr_create">
      <bpmn:lane id="Lane_role_staff_l3_pr_create_0" name="Staff">
