    <bpmn:sequenceFlow id="role_staff_l3_pr_create_Flow_6" sourceRef="role_staff_l3_pr_create_valid" targetRef="role_staff_l3_pr_create_failed" name="Tidak">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Tidak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
