      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="role_staff_l3_pr_create_start" name="Kebutuhan aksi">
      <bpmn:outgoing>role_staff_l3_pr_create_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="role_staff_l3_pr_create_input" name="Isi tujuan pembelian dan line produk">
      <bpmn:documentation>Request ini dijalankan oleh Staff; guard backend tetap berlaku.</bpmn:documentation>
      <bpmn:incoming>role_staff_l3_pr_create_Flow_0</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_pr_create_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="role_staff_l3_pr_create_check" name="Tujuan terisi; line ada; qty positif; harga estimasi lebih dari nol; produk aktif">
      <bpmn:documentation>Setelah kontrol akses HTTP; lihat l3-kontrol-request. </bpmn:documentation>
      <bpmn:incoming>role_staff_l3_pr_create_Flow_1</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_pr_create_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="role_staff_l3_pr_create_valid" name="Syarat terpenuhi?" gatewayDirection="Diverging">
      <bpmn:incoming>role_staff_l3_pr_create_Flow_2</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_pr_create_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>role_staff_l3_pr_create_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="role_staff_l3_pr_create_effect0" name="Insert PR DRAFT, creator dan lines">
      <bpmn:incoming>role_staff_l3_pr_create_Flow_3</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_pr_create_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="role_staff_l3_pr_create_effect1" name="Audit PUR-PR-001; commit">
      <bpmn:incoming>role_staff_l3_pr_create_Flow_4</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_pr_create_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="role_staff_l3_pr_create_done" name="Aksi selesai; hasil diterima">
      <bpmn:incoming>role_staff_l3_pr_create_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="role_staff_l3_pr_create_failed" name="Ditolak / gagal; tidak commit">
      <bpmn:incoming>role_staff_l3_pr_create_Flow_6</bpmn:incoming>
    </bpmn:endEvent>
