<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/role-staff-l3-pr-create" id="Definitions_role_staff_l3_pr_create" targetNamespace="https://simple-erp.local/bpm-haqi/role-staff-l3-pr-create" exporter="BPMN Impact Mapper pre-inference scenario" exporterVersion="1">
  <bpmn:process id="Process_role_staff_l3_pr_create" name="Buat Purchase Request - Staff" isExecutable="false">
    <bpmn:documentation>Hypothetical Staff P2P total-confirmation step. No Simple-ERP source is changed by this scenario.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_role_staff_l3_pr_create">
      <bpmn:lane id="Lane_role_staff_l3_pr_create_0" name="Staff">
        <bpmn:flowNodeRef>role_staff_l3_pr_create_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_pr_create_input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_pr_create_confirm_total</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_role_staff_l3_pr_create_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>role_staff_l3_pr_create_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_pr_create_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_pr_create_effect0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_pr_create_effect1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_pr_create_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_pr_create_failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="role_staff_l3_pr_create_start" name="Kebutuhan aksi">
      <bpmn:outgoing>role_staff_l3_pr_create_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="role_staff_l3_pr_create_confirm_total" name="Review and confirm estimated PR total">
      <bpmn:documentation>After entering PR lines, Staff sees the calculated quantity-times-unit-price total and explicitly confirms it before Create PR. Without confirmation, no create request is sent and no DRAFT is created. No backend rule, API field, or database change is required.</bpmn:documentation>
      <bpmn:incoming>role_staff_l3_pr_create_Flow_1</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_pr_create_Flow_confirm_total</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="role_staff_l3_pr_create_input" name="Isi tujuan pembelian dan line produk">
      <bpmn:documentation>Request ini dijalankan oleh Staff; guard backend tetap berlaku.</bpmn:documentation>
      <bpmn:incoming>role_staff_l3_pr_create_Flow_0</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_pr_create_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="role_staff_l3_pr_create_check" name="Tujuan terisi; line ada; qty positif; harga nonnegatif; produk aktif">
      <bpmn:documentation>Setelah kontrol akses HTTP; lihat l3-kontrol-request. </bpmn:documentation>
      <bpmn:incoming>role_staff_l3_pr_create_Flow_confirm_total</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_pr_create_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="role_staff_l3_pr_create_valid" name="Syarat terpenuhi?" gatewayDirection="Diverging">
      <bpmn:incoming>role_staff_l3_pr_create_Flow_2</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_pr_create_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>role_staff_l3_pr_create_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="role_staff_l3_pr_create_effect0" name="Insert PR DRAFT, creator dan lines">
      <bpmn:incoming>role_staff_l3_pr_create_Flow_3</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_pr_create_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="role_staff_l3_pr_create_effect1" name="Audit PUR-PR-001; commit">
      <bpmn:incoming>role_staff_l3_pr_create_Flow_4</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_pr_create_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="role_staff_l3_pr_create_done" name="Aksi selesai; hasil diterima">
      <bpmn:incoming>role_staff_l3_pr_create_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="role_staff_l3_pr_create_failed" name="Ditolak / gagal; tidak commit">
      <bpmn:incoming>role_staff_l3_pr_create_Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="role_staff_l3_pr_create_Flow_0" sourceRef="role_staff_l3_pr_create_start" targetRef="role_staff_l3_pr_create_input"/>
    <bpmn:sequenceFlow id="role_staff_l3_pr_create_Flow_confirm_total" sourceRef="role_staff_l3_pr_create_confirm_total" targetRef="role_staff_l3_pr_create_check"/>
    <bpmn:sequenceFlow id="role_staff_l3_pr_create_Flow_1" sourceRef="role_staff_l3_pr_create_input" targetRef="role_staff_l3_pr_create_confirm_total"/>
    <bpmn:sequenceFlow id="role_staff_l3_pr_create_Flow_2" sourceRef="role_staff_l3_pr_create_check" targetRef="role_staff_l3_pr_create_valid"/>
    <bpmn:sequenceFlow id="role_staff_l3_pr_create_Flow_3" sourceRef="role_staff_l3_pr_create_valid" targetRef="role_staff_l3_pr_create_effect0" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="role_staff_l3_pr_create_Flow_4" sourceRef="role_staff_l3_pr_create_effect0" targetRef="role_staff_l3_pr_create_effect1"/>
    <bpmn:sequenceFlow id="role_staff_l3_pr_create_Flow_5" sourceRef="role_staff_l3_pr_create_effect1" targetRef="role_staff_l3_pr_create_done"/>
    <bpmn:sequenceFlow id="role_staff_l3_pr_create_Flow_6" sourceRef="role_staff_l3_pr_create_valid" targetRef="role_staff_l3_pr_create_failed" name="Tidak">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Tidak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:collaboration id="Collab_role_staff_l3_pr_create">
    <bpmn:participant id="Pool_role_staff_l3_pr_create" name="Simple ERP" processRef="Process_role_staff_l3_pr_create"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_role_staff_l3_pr_create">
    <bpmndi:BPMNPlane id="Plane_role_staff_l3_pr_create" bpmnElement="Collab_role_staff_l3_pr_create">
      <bpmndi:BPMNShape id="Pool_role_staff_l3_pr_create_di" bpmnElement="Pool_role_staff_l3_pr_create" isHorizontal="true"><dc:Bounds x="20" y="100" width="2260" height="440"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_role_staff_l3_pr_create_0_di" bpmnElement="Lane_role_staff_l3_pr_create_0" isHorizontal="true"><dc:Bounds x="50" y="100" width="2230" height="220"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_role_staff_l3_pr_create_1_di" bpmnElement="Lane_role_staff_l3_pr_create_1" isHorizontal="true"><dc:Bounds x="50" y="320" width="2230" height="220"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="role_staff_l3_pr_create_start_di" bpmnElement="role_staff_l3_pr_create_start"><dc:Bounds x="200" y="171" width="38" height="38"/><bpmndi:BPMNLabel><dc:Bounds x="145" y="214" width="148" height="45"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="role_staff_l3_pr_create_confirm_total_di" bpmnElement="role_staff_l3_pr_create_confirm_total"><dc:Bounds x="650" y="145" width="178" height="90"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="role_staff_l3_pr_create_input_di" bpmnElement="role_staff_l3_pr_create_input"><dc:Bounds x="425" y="145" width="178" height="90"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="role_staff_l3_pr_create_check_di" bpmnElement="role_staff_l3_pr_create_check"><dc:Bounds x="875" y="365" width="178" height="90"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="role_staff_l3_pr_create_valid_di" bpmnElement="role_staff_l3_pr_create_valid"><dc:Bounds x="1100" y="383" width="54" height="54"/><bpmndi:BPMNLabel><dc:Bounds x="1045" y="442" width="164" height="45"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="role_staff_l3_pr_create_effect0_di" bpmnElement="role_staff_l3_pr_create_effect0"><dc:Bounds x="1325" y="365" width="178" height="90"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="role_staff_l3_pr_create_effect1_di" bpmnElement="role_staff_l3_pr_create_effect1"><dc:Bounds x="1550" y="365" width="178" height="90"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="role_staff_l3_pr_create_done_di" bpmnElement="role_staff_l3_pr_create_done"><dc:Bounds x="1775" y="391" width="38" height="38"/><bpmndi:BPMNLabel><dc:Bounds x="1720" y="434" width="148" height="45"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="role_staff_l3_pr_create_failed_di" bpmnElement="role_staff_l3_pr_create_failed"><dc:Bounds x="2000" y="391" width="38" height="38"/><bpmndi:BPMNLabel><dc:Bounds x="1945" y="434" width="148" height="45"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="role_staff_l3_pr_create_Flow_0_di" bpmnElement="role_staff_l3_pr_create_Flow_0"><di:waypoint x="238" y="190"/><di:waypoint x="425" y="190"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="role_staff_l3_pr_create_Flow_confirm_total_di" bpmnElement="role_staff_l3_pr_create_Flow_confirm_total"><di:waypoint x="828" y="190"/><di:waypoint x="850" y="190"/><di:waypoint x="850" y="410"/><di:waypoint x="875" y="410"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="role_staff_l3_pr_create_Flow_1_di" bpmnElement="role_staff_l3_pr_create_Flow_1"><di:waypoint x="603" y="190"/><di:waypoint x="650" y="190"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="role_staff_l3_pr_create_Flow_2_di" bpmnElement="role_staff_l3_pr_create_Flow_2"><di:waypoint x="1053" y="410"/><di:waypoint x="1100" y="410"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="role_staff_l3_pr_create_Flow_3_di" bpmnElement="role_staff_l3_pr_create_Flow_3"><di:waypoint x="1154" y="410"/><di:waypoint x="1325" y="410"/><bpmndi:BPMNLabel><dc:Bounds x="1155" y="355" width="150" height="45"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="role_staff_l3_pr_create_Flow_4_di" bpmnElement="role_staff_l3_pr_create_Flow_4"><di:waypoint x="1503" y="410"/><di:waypoint x="1550" y="410"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="role_staff_l3_pr_create_Flow_5_di" bpmnElement="role_staff_l3_pr_create_Flow_5"><di:waypoint x="1728" y="410"/><di:waypoint x="1775" y="410"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="role_staff_l3_pr_create_Flow_6_di" bpmnElement="role_staff_l3_pr_create_Flow_6"><di:waypoint x="1154" y="410"/><di:waypoint x="1172" y="410"/><di:waypoint x="1172" y="508"/><di:waypoint x="1982" y="508"/><di:waypoint x="1982" y="410"/><di:waypoint x="2000" y="410"/><bpmndi:BPMNLabel><dc:Bounds x="1830" y="355" width="150" height="45"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
