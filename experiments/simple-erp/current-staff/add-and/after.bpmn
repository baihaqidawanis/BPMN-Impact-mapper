      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="role_staff_l3_adj_submit_start" name="Kebutuhan aksi">
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="role_staff_l3_adj_submit_input" name="Kirim adjustment untuk review">
      <bpmn:documentation>Aktor alternatif pada lane, bukan dua persetujuan.</bpmn:documentation>
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_0</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="role_staff_l3_adj_submit_check" name="Lock adjustment DRAFT; versi cocok">
      <bpmn:documentation>Setelah kontrol akses HTTP; lihat l3-kontrol-request. </bpmn:documentation>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_2</bpmn:outgoing>
      <bpmn:incoming>ValidMasters</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="role_staff_l3_adj_submit_valid" name="Syarat terpenuhi?" gatewayDirection="Diverging">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_2</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="role_staff_l3_adj_submit_effect0" name="Ubah adjustment SUBMITTED">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_3</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="role_staff_l3_adj_submit_effect1" name="Audit INV-ADJ-002; commit">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_4</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_0" sourceRef="role_staff_l3_adj_submit_start" targetRef="role_staff_l3_adj_submit_input" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_1" sourceRef="role_staff_l3_adj_submit_input" targetRef="MasterChecksSplit" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_2" sourceRef="role_staff_l3_adj_submit_check" targetRef="role_staff_l3_adj_submit_valid" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_3" name="Ya" sourceRef="role_staff_l3_adj_submit_valid" targetRef="role_staff_l3_adj_submit_effect0">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_4" sourceRef="role_staff_l3_adj_submit_effect0" targetRef="role_staff_l3_adj_submit_effect1" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_5" sourceRef="role_staff_l3_adj_submit_effect1" targetRef="role_staff_l3_adj_submit_result_merge" name="Aksi selesai; hasil diterima" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_6" name="Tidak; Ditolak / gagal; tidak commit" sourceRef="role_staff_l3_adj_submit_valid" targetRef="role_staff_l3_adj_submit_result_merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Tidak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="role_staff_l3_adj_submit_done" name="Respons dikirim">
      <bpmn:incoming>role_staff_l3_adj_submit_result_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="role_staff_l3_adj_submit_result_merge" name="Gabungkan hasil alternatif" gatewayDirection="Converging">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_5</bpmn:incoming>
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_6</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_result_to_activity</bpmn:outgoing>
      <bpmn:incoming>InvalidMasters</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="role_staff_l3_adj_submit_result_activity" name="Kirim respons hasil aksi (sukses atau gagal)">
      <bpmn:documentation>Explicit presentation of existing response handling. Preserve success/error status and payload; no extra commit or state change.</bpmn:documentation>
      <bpmn:incoming>role_staff_l3_adj_submit_result_to_activity</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_result_to_end</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_result_to_activity" sourceRef="role_staff_l3_adj_submit_result_merge" targetRef="role_staff_l3_adj_submit_result_activity" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_result_to_end" sourceRef="role_staff_l3_adj_submit_result_activity" targetRef="role_staff_l3_adj_submit_done" />
    <bpmn:parallelGateway id="MasterChecksSplit" name="Run both stock adjustment master-data checks" gatewayDirection="Diverging">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_1</bpmn:incoming>
      <bpmn:outgoing>CheckWarehouseStart</bpmn:outgoing>
      <bpmn:outgoing>CheckProductsStart</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="MasterChecksJoin" name="Both validation results collected" gatewayDirection="Converging">
      <bpmn:incoming>CheckWarehouseDone</bpmn:incoming>
      <bpmn:incoming>CheckProductsDone</bpmn:incoming>
      <bpmn:outgoing>CombineResults</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="CheckWarehouse" name="Validate warehouse is still active">
      <bpmn:incoming>CheckWarehouseStart</bpmn:incoming>
      <bpmn:outgoing>CheckWarehouseDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="CheckWarehouseStart" sourceRef="MasterChecksSplit" targetRef="CheckWarehouse" />
    <bpmn:sequenceFlow id="CheckWarehouseDone" sourceRef="CheckWarehouse" targetRef="MasterChecksJoin" />
    <bpmn:serviceTask id="CheckProducts" name="Validate all products are still active">
      <bpmn:incoming>CheckProductsStart</bpmn:incoming>
      <bpmn:outgoing>CheckProductsDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="CheckProductsStart" sourceRef="MasterChecksSplit" targetRef="CheckProducts" />
    <bpmn:sequenceFlow id="CheckProductsDone" sourceRef="CheckProducts" targetRef="MasterChecksJoin" />
    <bpmn:serviceTask id="CombineValidation" name="Aggregate validation results without changing stock or status">
      <bpmn:incoming>CombineResults</bpmn:incoming>
      <bpmn:outgoing>DecideResults</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="CombineResults" sourceRef="MasterChecksJoin" targetRef="CombineValidation" />
    <bpmn:exclusiveGateway id="MasterDecision" name="Both checks passed?" gatewayDirection="Diverging" default="InvalidMasters">
      <bpmn:incoming>DecideResults</bpmn:incoming>
      <bpmn:outgoing>ValidMasters</bpmn:outgoing>
      <bpmn:outgoing>InvalidMasters</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="DecideResults" sourceRef="CombineValidation" targetRef="MasterDecision" />
    <bpmn:sequenceFlow id="ValidMasters" sourceRef="MasterDecision" targetRef="role_staff_l3_adj_submit_check" name="warehouse active and all products active">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">warehouse active and all products active</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="InvalidMasters" sourceRef="MasterDecision" targetRef="role_staff_l3_adj_submit_result_merge" />
  </bpmn:process>
