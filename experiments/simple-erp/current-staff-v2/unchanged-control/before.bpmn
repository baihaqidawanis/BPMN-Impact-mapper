  <bpmn:process id="Process_role_staff_l3_adj_submit" name="Submit stock adjustment - Staff" isExecutable="false">
    <bpmn:documentation>Level 3; generator source snapshot; descriptive as-is working tree, not deployed-runtime proof.
 Pelaksana request: Staff; guard backend tetap berlaku.
backend/internal/inventory/adapter/postgres/store.go :: TransitionAdjustment</bpmn:documentation>
    <bpmn:laneSet id="Lanes_role_staff_l3_adj_submit">
      <bpmn:lane id="Lane_role_staff_l3_adj_submit_0" name="Staff">
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_input</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_role_staff_l3_adj_submit_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>role_staff_l3_adj_submit_check</bpmn:flowNodeRef>
