        <bpmn:flowNodeRef>RejectMissingReason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MasterChecksSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckWarehouse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckProducts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MasterChecksJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CombineValidation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MasterDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RejectInvalidMaster</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="role_staff_l3_adj_submit_start" name="Kebutuhan aksi">
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="role_staff_l3_adj_submit_input" name="Kirim adjustment untuk review">
      <bpmn:documentation>Aktor alternatif pada lane, bukan dua persetujuan.</bpmn:documentation>
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_0</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="role_staff_l3_adj_submit_check" name="Lock adjustment DRAFT; versi cocok">
      <bpmn:documentation>Setelah kontrol akses HTTP; lihat l3-kontrol-request. </bpmn:documentation>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_2</bpmn:outgoing>
      <bpmn:incoming>ChecksPassed</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="role_staff_l3_adj_submit_valid" name="Syarat terpenuhi?" gatewayDirection="Diverging">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_2</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="role_staff_l3_adj_submit_effect0" name="Ubah adjustment SUBMITTED">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_3</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="role_staff_l3_adj_submit_effect1" name="Audit INV-ADJ-002; commit">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_4</bpmn:incoming>
      <bpmn:outgoing>role_staff_l3_adj_submit_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_0" sourceRef="role_staff_l3_adj_submit_start" targetRef="role_staff_l3_adj_submit_input" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_1" sourceRef="role_staff_l3_adj_submit_input" targetRef="ReasonDecision" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_2" sourceRef="role_staff_l3_adj_submit_check" targetRef="role_staff_l3_adj_submit_valid" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_3" name="Ya" sourceRef="role_staff_l3_adj_submit_valid" targetRef="role_staff_l3_adj_submit_effect0">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_4" sourceRef="role_staff_l3_adj_submit_effect0" targetRef="role_staff_l3_adj_submit_effect1" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_5" sourceRef="role_staff_l3_adj_submit_effect1" targetRef="ResponseMerge" name="Aksi selesai; hasil diterima" />
    <bpmn:sequenceFlow id="role_staff_l3_adj_submit_Flow_6" name="Tidak; Ditolak / gagal; tidak commit" sourceRef="role_staff_l3_adj_submit_valid" targetRef="ResponseMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Tidak</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="ResponseMerge" name="Gabungkan hasil alternatif" gatewayDirection="Converging">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_5</bpmn:incoming>
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_6</bpmn:incoming>
      <bpmn:outgoing>MergeToResponse</bpmn:outgoing>
      <bpmn:incoming>ReasonRejected</bpmn:incoming>
      <bpmn:incoming>MasterRejected</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="ReturnResponse" name="Kirim respons hasil aksi (sukses atau gagal)">
      <bpmn:documentation>Abstraction of inventory HTTP Handler.action: respond 409 with error message or respond 200 with document. Preserve outcome and status. No shared commit is introduced.</bpmn:documentation>
      <bpmn:incoming>MergeToResponse</bpmn:incoming>
      <bpmn:outgoing>ResponseToEnd</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="ResponseDelivered" name="Respons dikirim">
      <bpmn:incoming>ResponseToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="MergeToResponse" sourceRef="ResponseMerge" targetRef="ReturnResponse" />
    <bpmn:sequenceFlow id="ResponseToEnd" sourceRef="ReturnResponse" targetRef="ResponseDelivered" />
    <bpmn:exclusiveGateway id="ReasonDecision" name="Reason supplied?" gatewayDirection="Diverging" default="ReasonMissing">
      <bpmn:incoming>role_staff_l3_adj_submit_Flow_1</bpmn:incoming>
      <bpmn:outgoing>ReasonPresent</bpmn:outgoing>
      <bpmn:outgoing>ReasonMissing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="RejectMissingReason" name="Prepare rejection: reason is required">
      <bpmn:incoming>ReasonMissing</bpmn:incoming>
      <bpmn:outgoing>ReasonRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="MasterChecksSplit" name="Run both master-data checks" gatewayDirection="Diverging">
      <bpmn:incoming>ReasonPresent</bpmn:incoming>
      <bpmn:outgoing>CheckWarehouseStart</bpmn:outgoing>
      <bpmn:outgoing>CheckProductsStart</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="CheckWarehouse" name="Validate warehouse is still active">
      <bpmn:incoming>CheckWarehouseStart</bpmn:incoming>
      <bpmn:outgoing>WarehouseChecked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CheckProducts" name="Validate all products are still active">
      <bpmn:incoming>CheckProductsStart</bpmn:incoming>
      <bpmn:outgoing>ProductsChecked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="MasterChecksJoin" name="Collect both validation results" gatewayDirection="Converging">
      <bpmn:incoming>WarehouseChecked</bpmn:incoming>
      <bpmn:incoming>ProductsChecked</bpmn:incoming>
      <bpmn:outgoing>CombineChecks</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="CombineValidation" name="Aggregate results without changing stock or status">
      <bpmn:incoming>CombineChecks</bpmn:incoming>
      <bpmn:outgoing>DecideChecks</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="MasterDecision" name="Both checks passed?" gatewayDirection="Diverging" default="ChecksFailed">
      <bpmn:incoming>DecideChecks</bpmn:incoming>
      <bpmn:outgoing>ChecksPassed</bpmn:outgoing>
      <bpmn:outgoing>ChecksFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="RejectInvalidMaster" name="Prepare rejection: inactive master data">
      <bpmn:incoming>ChecksFailed</bpmn:incoming>
      <bpmn:outgoing>MasterRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="ReasonPresent" sourceRef="ReasonDecision" targetRef="MasterChecksSplit" name="reason is not empty">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reason is not empty</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ReasonMissing" sourceRef="ReasonDecision" targetRef="RejectMissingReason" />
    <bpmn:sequenceFlow id="ReasonRejected" sourceRef="RejectMissingReason" targetRef="ResponseMerge" />
    <bpmn:sequenceFlow id="CheckWarehouseStart" sourceRef="MasterChecksSplit" targetRef="CheckWarehouse" />
    <bpmn:sequenceFlow id="CheckProductsStart" sourceRef="MasterChecksSplit" targetRef="CheckProducts" />
    <bpmn:sequenceFlow id="WarehouseChecked" sourceRef="CheckWarehouse" targetRef="MasterChecksJoin" />
    <bpmn:sequenceFlow id="ProductsChecked" sourceRef="CheckProducts" targetRef="MasterChecksJoin" />
    <bpmn:sequenceFlow id="CombineChecks" sourceRef="MasterChecksJoin" targetRef="CombineValidation" />
    <bpmn:sequenceFlow id="DecideChecks" sourceRef="CombineValidation" targetRef="MasterDecision" />
    <bpmn:sequenceFlow id="ChecksPassed" sourceRef="MasterDecision" targetRef="role_staff_l3_adj_submit_check" name="warehouse active and all products active">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">warehouse active and all products active</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ChecksFailed" sourceRef="MasterDecision" targetRef="RejectInvalidMaster" />
    <bpmn:sequenceFlow id="MasterRejected" sourceRef="RejectInvalidMaster" targetRef="ResponseMerge" />
  </bpmn:process>
